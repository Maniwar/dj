{
  "name": "club-humidity",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "System Overload // Club Humidity — The Moist Mix 2002. A campy Y2K cyber-club promo site.",
  "scripts": {
    "gen:tracks": "node scripts/build-tracks.mjs",
    "gen:lyrics": "node scripts/build-lyrics.mjs",
    "prebuild": "npm run gen:tracks && npm run gen:seo",
    "predev": "node scripts/build-tracks.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "gen:images": "node scripts/gen-gemini-images.mjs",
    "gen:videos": "node scripts/gen-atlascloud-videos.mjs",
    "gen:seo": "node scripts/build-seo.mjs",
    "verify:fx": "node scripts/verify-fx-off.mjs",
    "verify:diag": "node scripts/verify-diag.mjs",
    "verify:profiles": "node scripts/verify-profiles.mjs",
    "verify:intensity": "node scripts/verify-intensity.mjs",
    "verify:video": "node scripts/verify-video-pref.mjs",
    "deploy:worker": "wrangler deploy --config worker/wrangler.toml",
    "worker:tail": "wrangler tail --config worker/wrangler.toml",
    "verify:tier": "node scripts/verify-tier.mjs",
    "qa:fx": "node scripts/fx-visual-qa.mjs",
    "verify:glsl": "node scripts/verify-glsl.mjs",
    "gen:jussi": "node scripts/gen-jussi-gemini.mjs",
    "gen:outtakes": "node scripts/gen-outtakes-gemini.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "playwright-core": "^1.61.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vite-plugin-static-copy": "^1.0.6",
    "wrangler": "^4.116.0"
  }
}
