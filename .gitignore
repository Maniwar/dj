node_modules
dist
.smoke
smoke-shots
*.log
.DS_Store
.vite

# secrets — API keys must never reach GitHub
.env
.env.*
# ...except this one. It holds ONLY public values — the Turnstile SITE key and the Worker URL,
# both of which ship in the JS bundle regardless — and GitHub Actions needs them at build time.
# Ignoring it would leave the guestbook permanently dormant in production while working locally,
# which is the kind of failure nobody notices. Secrets still live only in Worker secrets.
!.env.production
!.env.example

# intermediate uncompressed video renders (we commit the compressed .mp4)
*.raw.mp4

# album-cover working copy of the source frame (the original lives in public/assets)
artwork/bg.jpg
artwork/bg-rig.jpg

# QA screenshot output
ultrawide-shots/
smoke-shots/
qa-shots/

# 1080p video masters (kept local, out of the Pages deploy)
video-masters/

# local forced-alignment venv (tooling is scripts/align-lyrics.py)
.venv-align/
.align-cache/

# Spotify Canvas: raw Playwright capture is a build input, regenerate with artwork/canvas/record.mjs
artwork/canvas/raw/

# public/lyrics, public/robots.txt and public/sitemap.xml are GENERATED by
# scripts/build-seo.mjs (which prebuild runs) but are deliberately COMMITTED: they are the
# site's crawlable surface, and a diff is the only practical way to review what search
# engines will be served. Regenerate with `npm run gen:seo` rather than editing by hand.

# Local operational notes — deliberately untracked, not for the public repo.
worker/SETUP.local.md

# `wrangler dev --local` writes its Miniflare state here — an emulated copy of the KV namespace,
# including whatever like counts a local run happened to create. Local scratch, never the source of
# truth, and committing it would let a dev machine's test data look like production data.
.wrangler/
